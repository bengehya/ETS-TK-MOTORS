APP_NAME="TK MOTORS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Utilisée par Artisan et les files d'attente. Les pages web suivent l'hôte de la requête
# (localhost ou le tunnel HTTPS courant). Ne pas y figer une URL de tunnel.
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Kinshasa

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL en local et en production. Ne pas basculer le projet sur SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tk_motors
DB_USERNAME=tk_motors
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=5
SESSION_ENCRYPT=false
SESSION_PATH=/
# Vide : le cookie reste limité à l'hôte courant (localhost ou le tunnel du moment).
SESSION_DOMAIN=null

# Proxys dont l'hôte et le schéma transmis sont acceptés. Ne pas y mettre une URL.
# En production, indiquer l'adresse réelle du proxy, ou laisser vide si l'application est jointe directement.
TRUSTED_PROXIES=*

# Laisser absent pour que le cookie de session suive la requête : HTTP en local, HTTPS via le tunnel.
# SESSION_SECURE_COOKIE=

# Optionnel, uniquement pour le serveur Vite de développement. Ne pas y figer une URL de tunnel.
# VITE_DEV_SERVER_URL=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
